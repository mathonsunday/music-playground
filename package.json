{
  "name": "music-playground",
  "version": "2.3.2",
  "description": "A Web Audio API library for generating atmospheric soundscapes programmatically. Perfect for adding ambient audio to themed web projects, games, or interactive experiences.",
  "keywords": [
    "web-audio",
    "ambient",
    "soundscape",
    "procedural-audio",
    "themes",
    "audio-synthesis",
    "interactive-audio"
  ],
  "author": "",
  "license": "MIT",
  "lint-staged": {
    "*.ts": "npm run test -- --run --related"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mathonsunday/music-playground.git"
  },
  "type": "module",
  "main": "dist/music-playground.umd.js",
  "module": "dist/music-playground.esm.js",
  "unpkg": "dist/music-playground.umd.js",
  "jsdelivr": "dist/music-playground.umd.js",
  "exports": {
    ".": {
      "import": "./dist/music-playground.esm.js",
      "require": "./dist/music-playground.umd.js",
      "default": "./dist/music-playground.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run --reporter=verbose --coverage"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "happy-dom": "^20.1.0",
    "husky": "^9.0.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^15.0.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "soundfont-player": "^0.12.0",
    "tone": "^15.1.22"
  }
}
